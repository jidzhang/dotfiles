// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "proxy": "",
  "disable_ai": true,
  "session": {
    "trust_all_worktrees": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "calt": true,
  },
  "buffer_line_height": "comfortable",
  "text_rendering_mode": "subpixel",
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark",
  },
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing",
  "confirm_quit": false,
  "restore_on_startup": "last_session",
  "restore_on_file_reopen": true,
  "close_on_file_delete": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_panel_on_toggle": true,
  "max_tabs": null,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
    "show_close_button": "always",
    "activate_on_close": "history",
    "show_diagnostics": "all",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "large",
    "skip_focus_for_active_in_search": true,
    "include_ignored": "smart",
    "include_channels": false,
  },
  "search_wrap": true,
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "always",
  "search": {
    "button": true,
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false,
    "center_on_match": false,
  },
  "use_autoclose": true,
  "use_auto_surround": true,
  "always_treat_brackets_as_autoclosed": true,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,
  "extend_comment_on_newline": true,
  "extend_list_on_newline": true,
  "indent_list_on_tab": true,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 100,
  },
  "format_on_save": "off",
  "formatter": "auto",
  "use_on_type_format": true,
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "line_ending": "detect",
  "soft_wrap": "editor_width",
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "wrap_guides": [80, 120],
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 5,
  "horizontal_scroll_margin": 5,
  "scroll_sensitivity": 1.5,
  "fast_scroll_sensitivity": 6.0,
  "mouse_wheel_zoom": true,
  "autoscroll_on_clicks": false,
  "current_line_highlight": "all",
  "selection_highlight": true,
  "minimap": {
    "show": "always",
    "display_in": "all_editors",
    "thumb": "always",
    "max_width_columns": 100,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "scrollbar": {
    "show": "always",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
  },
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "bookmarks": true,
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 4,
  },
  "colorize_brackets": true,
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 3,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "show_whitespaces": "selection",
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": false,
    "code_actions": true,
  },
  "status_bar": {
    "experimental.show": true,
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "non_utf8",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_menus": false,
  },
  "autosave": "on_focus_change",
  "hover_popover_enabled": true,
  "hover_popover_delay": 150,
  "hover_popover_sticky": true,
  "hover_popover_hiding_delay": 200,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "completion_menu_scrollbar": "always",
  "snippet_sort_order": "top",
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "inline_code_actions": true,
  "code_lens": "on",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_value_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 200,
    "scroll_debounce_ms": 30,
  },
  "enable_language_server": true,
  "lsp_highlight_debounce": 50,
  "semantic_tokens": "combined",
  "lsp_document_colors": "background",
  "linked_edits": true,
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 100,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "diagnostics_max_severity": "all",
  "diff_view_style": "split",
  "minimum_split_diff_width": 60,
  "word_diff_enabled": true,
  "go_to_definition_fallback": "find_all_references",
  "go_to_definition_scroll_strategy": "center",
  "git": {
    "disable_git": false,
    "enable_status": true,
    "enable_diff": true,
    "git_gutter": "tracked_files",
    "gutter_debounce": 0,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
      "padding": 7,
      "show_commit_summary": false,
      "min_column": 0,
    },
    "hunk_style": "staged_hollow",
    "path_style": "file_name_first",
  },
  "project_panel": {
    "button": true,
    "hide_gitignore": false,
    "default_width": 260,
    "dock": "left",
    "entry_spacing": "standard",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 16,
    "auto_reveal_entries": true,
    "starts_open": true,
    "auto_fold_dirs": true,
    "bold_folder_labels": false,
    "show_diagnostics": "all",
    "sticky_scroll": true,
    "sort_mode": "directories_first",
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "drag_and_drop": true,
    "hide_root": false,
    "hide_hidden": false,
    "auto_open": {
      "on_create": true,
      "on_paste": true,
      "on_drop": true,
    },
  },
  "outline_panel": {
    "button": true,
    "default_width": 280,
    "dock": "right",
    "file_icons": true,
    "indent_size": 16,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
  "terminal": {
    "shell": "system",
    "dock": "bottom",
    "flexible": true,
    "default_width": 640,
    "default_height": 320,
    "working_directory": "current_project_directory",
    "blinking": "terminal_controlled",
  },
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "unnecessary_code_fade": 0.1,
  "hard_tabs": false,
  "tab_size": 4,
  "show_edit_predictions": false,
  "languages": {
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "Plain Text": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "completions": {
        "words": "disabled",
      },
    },
  },
}
